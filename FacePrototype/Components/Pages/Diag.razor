@page "/diag"
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
<div class="parentDiv">
    <div class="tableSideDiv">
        <InputFile OnChange="OnFilesSelected" Multiple accept="application/json" />
    </div>
    <div class="faceSideDiv">
        <div class="faceSideDivWithoutScroll" id="faceImageAndDescription">
            <canvas id="myChart" style="width:100%; height:100%;"></canvas>
        </div>
    </div>
</div>

@code {
