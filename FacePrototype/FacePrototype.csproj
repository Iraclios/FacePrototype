    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>


    <ItemGroup>
      <Content Remove="Data\Baby.json" />
      <Content Remove="Data\Boy.json" />
      <Content Remove="Data\Female.json" />
      <Content Remove="Data\Girl.json" />
      <Content Remove="Data\Male.json" />
      <Content Remove="Data\TeenagerBoy.json" />
      <Content Remove="Data\TeenagerGirl.json" />
    </ItemGroup>


    <ItemGroup>
      <EmbeddedResource Include="Data\Baby.json">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </EmbeddedResource>
      <EmbeddedResource Include="Data\Boy.json" />
      <EmbeddedResource Include="Data\Female.json" />
      <EmbeddedResource Include="Data\Girl.json" />
      <EmbeddedResource Include="Data\Male.json" />
      <EmbeddedResource Include="Data\TeenagerBoy.json" />
      <EmbeddedResource Include="Data\TeenagerGirl.json" />
    </ItemGroup>

